*.nbc
*.nbi

# Virtual Environment
venv/
env/
ENV/
.venv

# Jupyter Notebook
.ipynb_checkpoints

# Training outputs and checkpoints
checkpoints/
logs/
match_logs/

# Hyperparameter sweep results
hyperparam_results/

# Tournament reports (large directories with PNGs and reports)
tournament_reports/

# Hall of Fame agents (optional - comment out if you want to track these)
hall_of_fame/champions/*.npy
hall_of_fame/milestones/*.npy
hall_of_fame/archived/*.npy

# TensorBoard
runs/

# Pytest cache
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Model files (if large)
*.pkl
# ...but a solved strategy under results/ is a result, not a build artifact.
# These were excluded by the blanket rule above, so the strategy behind every
# CFR number -- the panel's opponent, Phase 4's yardstick, the GUI's agent, both
# Slumbot runs -- existed only on the machine that trained it, and no clone or
# checkout could produce it. Negated rather than force-added so the next one is
# tracked without anyone having to remember.
!results/**/*.pkl
# ...except the mid-run checkpoints, which are crash insurance rather than a
# result. They are rewritten fifty times a run and superseded by the final file.
*.partial.pkl
*.partial.json
*.h5
*.pth

# Profiling
*.prof
*.stats
profile.stats

# Generated reports (user can regenerate these)
deep_sweep_report.txt
tournament_history_analysis.txt
ai_hands_log.txt
analysis_report.txt

# Keep documentation files but ignore outdated ones
# OPTIMIZATION_*.md files are kept in repo
# HYPERPARAMETER_RELATIONSHIPS.md is kept in repo

# Claude Code: the train skill is shared, the local permission allowlist is not
# (it pins process IDs from whichever session happened to grant them).
.claude/settings.local.json

# Precomputed equity tables. Derived data, 15 MB for the flop alone and ~75 MB
# with the turn, and `scripts/cfr/build_equity_table.py` rebuilds the flop in
# 1.6 minutes. Git would carry them forever for no benefit.
results/cfr/equity_tables/

# Native build artifacts. `native/build.sh` regenerates them; the sources are
# tracked, the compiled module is not.
native/build/
*.so

# The arena bot's weapons and its record: the solvers it plays on Chipzen and
# every decision it took there. Public code, private weights; see docs/chipzen.md.
results/cfr/ladder/
results/cfr/ladder200/
results/cfr/experiments/
# The season 6 ladders with real solves in them (about 2.2 GB together); the
# ladder169l_v* directories are symlinks into experiments/ and stay tracked so
# the composition of each played set is on record.
results/cfr/ladder169l/
results/cfr/ladder169l_v6/
results/cfr/ladder169l_short/
results/cfr/ladder200t/
results/cfr/contender/
results/chipzen/matches/
results/chipzen/review.md
# The scout's fetch cache of other bots' hands (18 MB of one-line JSON, refetched
# from the arena on demand), and the profiles and reads built from it: they say
# what we noticed about each opponent, which is the one thing that would make
# its owner fix it. Kept locally, like the weights and the read thresholds.
results/chipzen/scout/hands/
results/chipzen/scout/*.json
results/chipzen/opponents.json
# The working document. Kept locally from 22 September 2026: it is an honest
# inventory of where the bot is weak, which is what it is for, and that is not
# something to publish next to the code. Its history to that date is public.
NEXT.md

# Base papers for the course presentation: other people's PDFs, kept locally only.
docs/base-papers/

# PDF previews rendered from the Word and PowerPoint sources.
docs/NashForge_*.pdf
results/cfr/ladder169/cap2_100bb.pkl
