.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Model files (if large)
*.pkl
# ...but a solved strategy under results/ is a result, not a build artifact.
# These were excluded by the blanket rule above, so the strategy behind every
# CFR number -- the panel's opponent, Phase 4's yardstick, the GUI's agent, both
# Slumbot runs -- existed only on the machine that trained it, and no clone or
# checkout could produce it. Negated rather than force-added so the next one is
# tracked without anyone having to remember.
!results/**/*.pkl
*.h5
*.pth

# Profiling
*.prof
*.stats
profile.stats

# Generated reports (user can regenerate these)
deep_sweep_report.txt
tournament_history_analysis.txt
ai_hands_log.txt
analysis_report.txt

# Keep documentation files but ignore outdated ones
# OPTIMIZATION_*.md files are kept in repo
# HYPERPARAMETER_RELATIONSHIPS.md is kept in repo

# Claude Code: the train skill is shared, the local permission allowlist is not
# (it pins process IDs from whichever session happened to grant them).
.claude/settings.local.json
